# Application
APP_NAME=TicketFlow
APP_ENVIRONMENT=development

# PostgreSQL container and async application connection
POSTGRES_DB=ticketflow
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=replace-with-a-development-database-password
DATABASE_URL=postgresql+asyncpg://ticketflow:replace-with-a-development-database-password@postgres:5432/ticketflow

# Redis uses the Docker Compose service hostname
REDIS_URL=redis://redis:6379/0

# Token settings are configured now; token creation begins in Phase 2
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Idempotent development support-agent seed
SEEDED_AGENT_EMAIL=support@example.com
SEEDED_AGENT_PASSWORD=replace-with-a-development-agent-password
